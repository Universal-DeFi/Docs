{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Universal Mint Help Center",
  "description": "Guides for investors and issuers using Universal Mint.",
  "colors": {
    "primary": "#B31942",
    "light": "#E25C80",
    "dark": "#83102E"
  },
  "fonts": {
    "family": "DM Sans"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://universalmint.io"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help center",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/how-it-works",
              "get-started/create-an-account",
              "get-started/sign-in"
            ]
          },
          {
            "group": "Account and security",
            "pages": [
              "account/passkeys-and-recovery",
              "account/signing-keys",
              "account/identity-verification",
              "account/wallets",
              "account/delivery-addresses",
              "account/settings-and-notifications"
            ]
          },
          {
            "group": "Investors",
            "pages": [
              "investors/getting-started",
              "investors/request-tokens",
              "investors/redeem-tokens",
              "investors/track-requests",
              "investors/fees-and-limits"
            ]
          },
          {
            "group": "Issuers",
            "pages": [
              "issuers/create-an-organization",
              "issuers/team-and-invitations",
              "issuers/approval-groups",
              "issuers/delegation",
              "issuers/custodians",
              "issuers/list-a-token",
              "issuers/manage-tokens",
              "issuers/investor-requests",
              "issuers/disclosures",
              "issuers/audit-log"
            ]
          },
          {
            "group": "Trust and transparency",
            "pages": [
              "trust/how-records-work",
              "trust/public-pages"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/troubleshooting",
              "support/glossary",
              "support/contact"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Universal Mint app",
          "href": "https://app.universalmint.io",
          "icon": "arrow-up-right-from-square"
        },
        {
          "anchor": "Listed tokens",
          "href": "https://app.universalmint.io/listed-tokens",
          "icon": "coins"
        },
        {
          "anchor": "Website",
          "href": "https://universalmint.io",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@universalmint.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.universalmint.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Universal Mint",
        "items": [
          {
            "label": "Website",
            "href": "https://universalmint.io"
          },
          {
            "label": "Open app",
            "href": "https://app.universalmint.io"
          },
          {
            "label": "Admin console",
            "href": "https://admin.universalmint.io"
          }
        ]
      },
      {
        "header": "Help",
        "items": [
          {
            "label": "Contact support",
            "href": "mailto:support@universalmint.io"
          },
          {
            "label": "Disclosures",
            "href": "https://app.universalmint.io/transparency"
          }
        ]
      }
    ]
